generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SELLER
  CLIENT
  HOST
}
enum PartCondition {
  NEW
  USED
  EITHER
}
enum RequestStatus {
  PUBLISHED
  OFFERS_RECEIVED
  OFFER_ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}
enum OrderStatus {
  OFFER_ACCEPTED
  SELLER_CONFIRMED
  PREPARING
  READY
  DISPATCHED
  COMPLETED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  phone        String?
  passwordHash String
  role         UserRole      @default(SELLER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      SellerProfile?
  clientProfile ClientProfile?
  sessions     Session[]
  offers       Offer[]
  orders       Order[]
  parts        InventoryPart[]
  notifications Notification[]
  conversations ConversationParticipant[]
  messages     Message[]
  auditEvents  HostAuditLog[] @relation("HostAuditActor")
  sellerDocuments SellerDocument[] @relation("SellerDocuments")
  reviewedDocuments SellerDocument[] @relation("DocumentReviewer")
  clientRequests MarketplaceRequest[] @relation("ClientRequests")
}

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  phone     String?
  address   String?
  city      String?
  vehicles  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HostAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  action      String
  entityType  String
  entityId    String
  details     Json     @default("{}")
  createdAt   DateTime @default(now())
  actor       User     @relation("HostAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
}

model MarketplaceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  icon        String   @default("box")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model SellerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String
  shopName       String
  legalName      String?
  commercialName String?
  legalForm      String?
  rneNumber      String?
  taxIdentifier  String?
  address        String?
  city           String?
  governorate    String?
  postalCode     String?
  businessPhone  String?
  businessEmail  String?
  website        String?
  categories     String[] @default([])
  productsSold   String?
  salesType      String?
  locationType   String?
  experienceYears Int?
  businessHours  String?
  supportedMakes String[] @default([])
  specialties    String[] @default([])
  paymentTerms   String[] @default([])
  description    String   @default("")
  verificationStatus String @default("pending_verification")
  verificationRejectionReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([verificationStatus])
}

model SellerDocument {
  id              String   @id @default(cuid())
  sellerId        String
  kind            String
  originalName    String
  storageName     String   @unique
  mimeType        String
  size            Int
  sha256          String
  status          String   @default("pending")
  rejectionReason String?
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
  reviewerId      String?
  seller          User     @relation("SellerDocuments", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewer        User?    @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  @@unique([sellerId, kind])
  @@index([status, submittedAt])
}

model InventoryPart {
  id                 String        @id @default(cuid())
  sellerId           String
  partName           String
  sku                String
  oemReference       String?
  brand              String
  category           String
  description        String        @default("")
  compatibleVehicles String[]      @default([])
  condition          PartCondition @default(NEW)
  price              Decimal       @db.Decimal(12, 3)
  stock              Int           @default(0)
  minimumStock       Int           @default(0)
  warranty           String        @default("")
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  seller             User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  @@unique([sellerId, sku])
  @@index([sellerId, category, isActive])
  @@index([sellerId, stock])
  @@index([partName, brand, oemReference])
}

model MarketplaceRequest {
  id                 String        @id @default(cuid())
  clientId           String?
  partName           String
  category           String
  oemReference       String?
  brand              String?
  vehicleMake        String?
  vehicleModel       String?
  vehicleYear        Int?
  condition          PartCondition @default(EITHER)
  quantity           Int           @default(1)
  minBudget          Decimal?      @db.Decimal(12, 3)
  maxBudget          Decimal?      @db.Decimal(12, 3)
  location           String?
  deliveryMethod     String?
  description        String        @default("")
  status             RequestStatus @default(PUBLISHED)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  offers             Offer[]
  client             User?     @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Restrict)
  orders             Order[]
  conversations      Conversation[]
  @@index([status, category, createdAt])
}

model Offer {
  id                String        @id @default(cuid())
  sellerId          String
  requestId         String
  partName          String
  brand             String        @default("")
  referenceNumber   String        @default("")
  condition         PartCondition
  price             Decimal       @db.Decimal(12, 3)
  quantity          Int           @default(1)
  warranty          String        @default("")
  deliveryFee       Decimal       @default(0) @db.Decimal(12, 3)
  estimatedDelivery String        @default("")
  description       String        @default("")
  status            OfferStatus   @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  seller            User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  request           MarketplaceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  order             Order?
  @@index([sellerId, requestId, status])
  @@index([sellerId, status, createdAt])
}

model Order {
  id          String      @id @default(cuid())
  sellerId    String
  requestId   String
  offerId     String      @unique
  status      OrderStatus @default(OFFER_ACCEPTED)
  totalAmount Decimal     @db.Decimal(12, 3)
  deliveryInfo String     @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  seller      User        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  request     MarketplaceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  offer       Offer       @relation(fields: [offerId], references: [id], onDelete: Restrict)
  events      OrderEvent[]
  conversations Conversation[]
  @@index([sellerId, status, createdAt])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String      @default("")
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  requestId String?
  orderId   String?
  createdAt DateTime @default(now())
  request   MarketplaceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages  Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}
